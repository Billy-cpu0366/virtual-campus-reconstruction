{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.pi.local/git-handoff/receipt.v1.schema.json",
  "title": "Pi git-handoff stage receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "protocol-version",
    "receipt-id",
    "delivery-id",
    "attempt-id",
    "stage",
    "status",
    "created-at",
    "producer",
    "adapter-sha256",
    "project-id",
    "canonical-remote",
    "history-mode",
    "checks",
    "unresolved-risks"
  ],
  "properties": {
    "schema-version": {
      "const": 1
    },
    "protocol-version": {
      "const": "0.1"
    },
    "receipt-id": {
      "$ref": "#/$defs/id"
    },
    "delivery-id": {
      "$ref": "#/$defs/id"
    },
    "attempt-id": {
      "$ref": "#/$defs/id"
    },
    "stage": {
      "enum": ["prepare", "verify", "push"]
    },
    "status": {
      "enum": ["PASS", "FAIL", "STOPPED"]
    },
    "created-at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "command", "environment"],
      "properties": {
        "package": {
          "const": "pi-git-handoff"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "enum": ["prepare", "verify-push"]
        },
        "environment": {
          "enum": ["sandbox", "external"]
        }
      }
    },
    "adapter-sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest-sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact-index-sha256": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 of the immutable outbox SHA256SUMS file. It is added only after the prepare receipt and inventory exist."
    },
    "previous-receipt-sha256": {
      "$ref": "#/$defs/sha256"
    },
    "project-id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "canonical-remote": {
      "type": "string",
      "minLength": 1
    },
    "history-mode": {
      "enum": ["canonical", "snapshot"]
    },
    "canonical-base": {
      "$ref": "#/$defs/object-identity"
    },
    "delivery": {
      "$ref": "#/$defs/object-identity"
    },
    "remote-result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "tree", "verification"],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/git-oid"
        },
        "tree": {
          "$ref": "#/$defs/git-oid"
        },
        "verification": {
          "const": "remote-verified"
        }
      }
    },
    "files-sha256": {
      "$ref": "#/$defs/sha256"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check-result"
      }
    },
    "human-gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "method"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": ["not-required", "pending", "accepted", "rejected"]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "authority-ref": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unresolved-risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "history-mode": {
            "const": "snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "unresolved-risks": {
            "contains": {
              "const": "snapshot delivery is not directly mergeable into main"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": ["manifest-sha256", "canonical-base", "delivery", "files-sha256"]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": ["verify", "push"]
          }
        }
      },
      "then": {
        "required": ["manifest-sha256", "previous-receipt-sha256", "artifact-index-sha256", "canonical-base", "delivery", "files-sha256"]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "command": {
                "const": "prepare"
              },
              "environment": {
                "const": "sandbox"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": ["verify", "push"]
          }
        }
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "command": {
                "const": "verify-push"
              },
              "environment": {
                "const": "external"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "push"
          },
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": ["human-gate", "remote-result"],
        "properties": {
          "human-gate": {
            "properties": {
              "required": {
                "const": true
              },
              "status": {
                "const": "accepted"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["FAIL", "STOPPED"]
          }
        }
      },
      "then": {
        "required": ["failure"]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git-oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,119}$"
    },
    "object-identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {
          "$ref": "#/$defs/git-oid"
        },
        "tree": {
          "$ref": "#/$defs/git-oid"
        }
      }
    },
    "relative-path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+)$"
    },
    "check-result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "cwd", "exit-code", "result", "duration-ms", "log-sha256"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "$ref": "#/$defs/relative-path"
        },
        "exit-code": {
          "type": "integer"
        },
        "duration-ms": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "enum": ["PASS", "FAIL", "STOPPED"]
        },
        "log-sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
