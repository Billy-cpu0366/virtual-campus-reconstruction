{
  "name": "virtual-campus-reconstruction",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare:runtime": "node scripts/prepare-runtime-assets.mjs",
    "check:runtime": "node scripts/check-runtime-assets.mjs",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "browser:chunk-smoke": "node scripts/browser-chunk-smoke.mjs",
    "browser:layer-smoke": "node scripts/browser-layer-smoke.mjs",
    "browser:lifecycle-smoke": "node scripts/browser-lifecycle-smoke.mjs",
    "browser:collision-smoke": "node scripts/browser-collision-smoke.mjs",
    "browser:runtime-safety-smoke": "node scripts/browser-runtime-safety-smoke.mjs",
    "browser:mobile-input-smoke": "node scripts/browser-mobile-input-smoke.mjs",
    "browser:camera-smoke": "node scripts/browser-camera-smoke.mjs",
    "browser:entry-smoke": "node scripts/browser-entry-smoke.mjs",
    "browser:app-retry-smoke": "node scripts/browser-app-retry-smoke.mjs",
    "browser:content-smoke": "node scripts/browser-content-smoke.mjs",
    "browser:side-smoke": "node scripts/browser-side-smoke.mjs",
    "browser:perf-baseline": "node scripts/browser-perf-baseline.mjs",
    "check:perf-baseline-evidence": "node scripts/check-perf-baseline-evidence.mjs",
    "predev": "npm run prepare:runtime",
    "dev": "npm run check:runtime && vite",
    "prebuild": "npm run prepare:runtime",
    "build": "npm run check:runtime && vite build",
    "build:test-hooks": "npm run prepare:runtime && npm run check:runtime && vite build --mode test-hooks",
    "prepreview": "npm run prepare:runtime",
    "preview": "npm run check:runtime && vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
